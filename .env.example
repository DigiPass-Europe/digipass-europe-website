# --- Supabase (database, auth, storage). Leave empty to run in demo mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only; never exposed to the browser

# --- Sessions (demo mode cookie signing) ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Stripe (payment after Board approval) — not required to run ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Transactional email (Resend or Postmark) — not required to run ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="DigiPass:Europe <no-reply@digipass-europe.eu>"
BOARD_NOTIFICATION_EMAIL=membership@digipass-europe.eu

NEXT_PUBLIC_SITE_URL=https://digipass-europe.eu
